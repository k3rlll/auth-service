# Скопируйте в .env и задайте свои значения. Сам .env в git не попадает.

ENVIRONMENT=development

SERVER_HOST=0.0.0.0
SERVER_PORT=8090

POSTGRES_USER=auth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=auth
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# Приватный ключ RS256 для подписи access-токенов.
# Публичный ключ (keys/jwt_public.pem) нужен сервисам, которые проверяют токены.
# Создать пару: go run ./cmd/keygen
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
